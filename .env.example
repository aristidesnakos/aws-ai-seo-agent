# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# PageSpeed Insights API
PAGESPEED_API_KEY=your-pagespeed-api-key-here

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7

# S3 Buckets
S3_TEMP_BUCKET=seo-agent-temp-data
S3_REPORTS_BUCKET=seo-agent-reports

# Lambda Configuration
INPUT_HANDLER_ARN=arn:aws:lambda:us-east-1:123456789012:function:seo-agent-input-handler
PAGESPEED_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:seo-agent-pagespeed-collector
CRAWLER_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:seo-agent-content-crawler
AI_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:seo-agent-ai-engine
REPORT_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:seo-agent-report-generator

# Lambda Settings
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512

# API Configuration
API_GATEWAY_ID=your-api-gateway-id
API_STAGE=prod
API_RATE_LIMIT=100

# Application Settings
USER_AGENT=Mozilla/5.0 (compatible; SEO-Agent/1.0)
REQUEST_TIMEOUT=30
MAX_CONTENT_SIZE=10485760
REPORT_RETENTION_DAYS=90

# Logging
LOG_LEVEL=INFO
ENABLE_DEBUG=false

# Feature Flags
ENABLE_MOBILE_ANALYSIS=true
ENABLE_DESKTOP_ANALYSIS=true
ENABLE_MARKDOWN_REPORTS=true
